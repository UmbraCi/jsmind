{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "stripInternal": true,
        "allowJs": true,
        "checkJs": false,
        "rootDirs": ["../src"],
        "paths": {
            "@umbraci/jsmind": ["../src/index.ts"],
            "@umbraci/jsmind/*": ["../src/plugins/*"]
        },
        "outDir": "./generated",
        "baseUrl": "."
    },
    "include" : ["../src/**/*.ts", "../src/**/*.js"],
    "exclude": ["./generated/**/*"]
}
